<?xml version="1.0" encoding="UTF-8"?>
<!-- STATUS: structure verified against Apple's official sample
     project, never opened in Xcode. The EXAppExtensionAttributes /
     EXExtensionPointIdentifier pair below is copied from Apple's
     "Filtering traffic by URL" sample code (SimpleURLFilterExtension/
     Info.plist in docs-assets.developer.apple.com/published/
     ab6517c07cf8/FilteringTrafficByURL.zip, downloaded 2026-11-17):
     com.apple.networkextension.url-filter-control. The sample uses
     NO NSExtensionPrincipalClass - the @main-annotated provider
     class is the entry point - so none is declared here either.
     Replaces an earlier guessed placeholder
     (com.apple.networkextension.url-filter under NSExtension), which
     was wrong in BOTH key and value. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.networkextension.url-filter-control</string>
	</dict>
</dict>
</plist>
