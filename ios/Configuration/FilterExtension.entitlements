<?xml version="1.0" encoding="UTF-8"?>
<!-- STATUS: UNVERIFIED - hand-authored, never compiled or signed.
     Key corrected per Apple's Network Extensions Entitlement doc
     (developer.apple.com/documentation/bundleresources/entitlements/
     com.apple.developer.networking.networkextension): the key is
     com.apple.developer.networking.networkextension, an ARRAY OF
     STRINGS; "content-filter-provider" is a value in that array.
     "url-filter-provider" is also a STRING VALUE of the same array
     (never a standalone boolean key). The entitlement must be granted
     in the provisioning profile in ALL cases - no development
     configuration waives signed entitlements (TN3134 documents
     deployment restrictions, not entitlement waivers). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>content-filter-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kosherguard.shared</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>TEAMIDPLACEHOLDER.com.kosherguard.shared</string>
	</array>
</dict>
</plist>
