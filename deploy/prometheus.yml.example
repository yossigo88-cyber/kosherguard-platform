# Example only - not deployed. See monitoring.md.
global:
  scrape_interval: 30s
scrape_configs:
  - job_name: control-plane
    static_configs:
      - targets: ["127.0.0.1:8000"]
    metrics_path: /health
  - job_name: url-filter-server
    static_configs:
      - targets: ["127.0.0.1:8100"]
    metrics_path: /v1/dataset/manifest
    # Production: attach a per-device dataset credential here via
    # bearer_token_file - never inline credentials in this file.
